#!/usr/bin/env bash
#
# Update every dependency in the repo: package-lock.json, within the ranges
# in package.json, and the pinned actions in .github/workflows.
#
# No manifest is written. package.json carries ranges a human put there, so
# the lock file moves underneath them and crossing a major bound stays a
# manual edit. The actions have no lock file of their own — there the pinned
# version *is* the range, so pinact moves them across majors too.

# Both commands below act on the current directory, so the script has to be
# somewhere known rather than wherever it was called from.
cd "$(dirname "$0")/.." || exit 1

npm update

# Pin the actions in .github/workflows to commit SHAs and move them forward,
# honouring the three-day min_age in .pinact.yaml. Exit 2 means pinact found
# something it will not decide on its own — a branch ref, or a pin younger
# than min_age — which is worth reading but no reason to throw away the rest
# of the update. Any other failure is pinact itself failing, a GitHub API
# error or a rate limit, and fails the script with it.
#
# Unauthenticated GitHub API calls are capped at 60 an hour, which one run
# can get through, so lend it the gh token when there is one.
if [[ -z "${PINACT_GITHUB_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]] &&
    command -v gh >/dev/null 2>&1; then
    PINACT_GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
    [[ -n "$PINACT_GITHUB_TOKEN" ]] && export PINACT_GITHUB_TOKEN
fi
status=0
pinact run --update || status=$?
case "$status" in
    0) ;;
    2) echo "pinact left something for a person to decide, see above" ;;
    *) echo "pinact failed (exit $status)" >&2; exit "$status" ;;
esac
